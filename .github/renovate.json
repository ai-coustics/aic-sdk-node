{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", ":preserveSemverRanges", ":disablePeerDependencies"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["@napi-rs/cli", "napi", "napi-build", "napi-derive"],
      "addLabels": ["napi-rs"],
      "groupName": "napi-rs"
    },
    {
      "matchPackageNames": ["oxlint", "prettier", "@taplo/cli"],
      "groupName": "lint and format"
    }
  ],
  "commitMessagePrefix": "chore: ",
  "commitMessageAction": "bump up",
  "commitMessageTopic": "{{depName}} version",
  "ignoreDeps": []
}
